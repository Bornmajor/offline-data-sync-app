{
  "rules": {
    ".read": false,
    ".write": false,

    "notes": {
      "$ownerId": {
        ".read": "auth != null && auth.uid === $ownerId",
        ".write": "auth != null && auth.uid === $ownerId",

        "$noteId": {
          ".validate": "newData.hasChildren(['title'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
          },
          "description": {
            ".validate": "newData.isString() && newData.val().length <= 5000"
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
